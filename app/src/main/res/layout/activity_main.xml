<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ECEFF1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/btnBrush"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/alat_brush"
                android:textColor="#263238"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPen"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/alat_pen"
                android:textColor="#263238"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="8dp"
                android:background="#CFD8DC" />

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="8dp"
                android:background="#CFD8DC" />

            <Button
                android:id="@+id/btnHapus"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/aksi_hapus"
                android:textColor="#C62828"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSimpan"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/aksi_simpan"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </HorizontalScrollView>

    <com.bapakima.gambar.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
